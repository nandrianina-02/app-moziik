<?xml version="1.0" encoding="utf-8"?>
<!-- Le grand gadget : grande pochette à gauche ; titre, artiste, avancement et commandes à droite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gadget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gadget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/gadget_pochette"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/gadget_pochette_vide" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gadget_titre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Moziik"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gadget_artiste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Touchez pour écouter"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/gadget_progression"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/gadget_progression" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/gadget_precedent"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/gadget_touche"
                android:contentDescription="Titre précédent"
                android:padding="10dp"
                android:src="@drawable/lucide_skip_back_plein"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/gadget_lecture"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/gadget_bouton_principal"
                android:contentDescription="Lecture"
                android:padding="12dp"
                android:src="@drawable/lucide_play_plein"
                android:tint="#FF141416" />

            <ImageView
                android:id="@+id/gadget_suivant"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/gadget_touche"
                android:contentDescription="Titre suivant"
                android:padding="10dp"
                android:src="@drawable/lucide_skip_forward_plein"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
