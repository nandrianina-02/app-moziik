<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
            Fond de fenetre, visible entre la disparition du splash et le
            premier paint de la WebView. Sans lui, le blanc par defaut du
            theme AppCompat provoque un flash a chaque lancement, tres
            visible puisque Moziik s'ouvre en sombre.

            Volontairement la meme valeur que `android.backgroundColor` de
            capacitor.config.ts, et non une couleur DayNight : le theme de
            l'app est choisi DANS l'app (localStorage, voir
            context/ThemeProvider.tsx), pas par le systeme. Suivre le
            reglage systeme ici ferait clignoter en clair les telephones en
            mode clair dont l'utilisateur a choisi Moziik en sombre.
        -->
        <item name="android:windowBackground">@color/moziik_base</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>