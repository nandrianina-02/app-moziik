<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône de la notification de lecture.

  Android applique un masque : à partir de Lollipop, tout pixel non
  transparent d'une petite icône est repeint en blanc (ou en gris selon le
  thème système). Inutile donc d'y mettre le corail de la marque — seule la
  SILHOUETTE compte. D'où ces trois barres d'égaliseur pleines, lisibles à
  24 dp comme à 16 dp dans la barre d'état.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4,14 h3.2 a1,1 0 0 1 1,1 v4 a1,1 0 0 1 -1,1 h-3.2 a1,1 0 0 1 -1,-1 v-4 a1,1 0 0 1 1,-1 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.4,4 h3.2 a1,1 0 0 1 1,1 v14 a1,1 0 0 1 -1,1 h-3.2 a1,1 0 0 1 -1,-1 v-14 a1,1 0 0 1 1,-1 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.8,9 h3.2 a1,1 0 0 1 1,1 v9 a1,1 0 0 1 -1,1 h-3.2 a1,1 0 0 1 -1,-1 v-9 a1,1 0 0 1 1,-1 z" />
</vector>
